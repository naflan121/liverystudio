{
  "name": "livery-studio",
  "version": "0.2.0",
  "description": "Livery Studio — plan, generate, render, review and schedule RC scale-illusion videos (built on the Livery Lab brain) — Sholacase",
  "author": "Sholacase",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "package:win": "electron-vite build && electron-packager . \"Livery Studio\" --platform=win32 --arch=x64 --out=release --overwrite --app-version=0.2.0 --ignore=\"(^/src|^/release|^/scripts|^/output|\\.md$|electron-builder\\.yml|tsconfig|electron\\.vite)\"",
    "postinstall": "electron-rebuild -f -w better-sqlite3"
  },
  "dependencies": {
    "@fontsource/barlow-condensed": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "better-sqlite3": "^12.11.1",
    "playwright-core": "^1.63.0"
  },
  "devDependencies": {
    "@electron/packager": "^20.0.1",
    "@electron/rebuild": "^4.2.0",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.17",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^33.2.1",
    "electron-vite": "^2.3.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.7.2",
    "vite": "^5.4.11"
  },
  "productName": "Livery Studio"
}
